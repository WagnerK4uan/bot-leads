# Discord Developer Portal › sua aplicação › Bot › Reset Token
DISCORD_TOKEN=
# Developer Portal › General Information › Application ID
CLIENT_ID=
# Discord com Modo Desenvolvedor ligado: botão direito no ícone do servidor › Copiar ID
GUILD_ID=

# Opcionais
SLA_HORAS=2
SLA_PAUSA_HORAS=8
LEMBRETE_INTERVALO_MIN=30
EXPEDIENTE_INICIO=8
EXPEDIENTE_FIM=18
TZ_EXPEDIENTE=America/Sao_Paulo
# Feriados (contam como fim de semana). MM-DD repete todo ano; AAAA-MM-DD é data única
# (Carnaval, Sexta-feira Santa, Corpus Christi, emendas). Separe por vírgula.
FERIADOS=01-01,04-21,05-01,09-07,10-12,11-02,11-15,11-20,12-25
RESUMO_SEMANAL=true
METRICAS_MENSAL=true
